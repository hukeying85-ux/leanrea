#!/usr/bin/env bash
# gh-relay —— 在本沙箱里抓任意平台的素材。
#
# 原理：沙箱出网只放行 github / pypi / npm，直接请求小红书、抖音、B站、
# YouTube 会 TLS 握手被重置（HTTP 000）。但 GitHub Actions 的 runner 出网
# 不受限。所以把链接写进 .mediaqueue/urls.txt 推上去，让 runner 代跑，
# 结果 commit 回分支，本地 git pull 就能拿到。
#
# 用法：
#   tools/media-library/gh-relay "https://www.douyin.com/video/xxxx"
#   tools/media-library/gh-relay "url1" "url2" "url3"
#   tools/media-library/gh-relay --from links.txt
#   tools/media-library/gh-relay --status          # 看上次跑的结果
#
# 产物：media-raw/<云盘目录名>/<标题_ID>/  与原素材库目录结构一致
set -u

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT" || exit 1
QUEUE=".mediaqueue/urls.txt"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

usage() { sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

if [ $# -eq 0 ]; then usage; exit 1; fi

case "$1" in
  -h|--help) usage; exit 0 ;;
  --status)
    if [ -f media-raw/_LAST_RUN.md ]; then cat media-raw/_LAST_RUN.md
    else echo "还没有跑过。先给一条链接。"; fi
    exit 0 ;;
  --from)
    [ -f "$2" ] || { echo "找不到 $2"; exit 1; }
    mkdir -p .mediaqueue
    grep -v '^\s*#' "$2" | grep -v '^\s*$' >> "$QUEUE.lock" 2>/dev/null || true
    cp "$QUEUE.lock" "$QUEUE"; rm -f "$QUEUE.lock"
    ;;
  *)
    mkdir -p .mediaqueue
    : > "$QUEUE"
    for u in "$@"; do echo "$u" >> "$QUEUE"; done
    ;;
esac

# 去重
sort -u "$QUEUE" -o "$QUEUE"
echo "队列（$(wc -l < "$QUEUE") 条）："
sed 's/^/  - /' "$QUEUE"

echo ""
echo "推送到 $BRANCH …"
git add -f "$QUEUE"
git commit -q -m "media: queue $(wc -l < "$QUEUE") url(s)" 2>/dev/null || echo "(无变更，强制触发)"
# 用空提交确保 workflow 一定触发
git commit -q --allow-empty -m "media: trigger relay"
git push origin "$BRANCH" || { echo "推送失败"; exit 1; }

echo ""
echo "已触发 GitHub Actions。等待 runner 完成（通常 1–3 分钟）…"
RUN_ID=""
for i in $(seq 1 60); do
  sleep 10
  RUN_ID=$(gh run list --workflow media-relay --branch "$BRANCH" --limit 1 \
             --json databaseId --jq '.[0].databaseId' 2>/dev/null)
  [ -n "$RUN_ID" ] || continue
  STATE=$(gh run view "$RUN_ID" --json status --jq '.status' 2>/dev/null)
  case "$STATE" in
    completed) break ;;
    *) printf "\r  状态：${STATE:-排队中}  (${i}0s)" ;;
  esac
done
echo ""

if [ -z "$RUN_ID" ]; then echo "拿不到 workflow run，手动看：https://github.com/$(gh repo view --json nameWithOwner --jq .nameWithOwner)/actions"; exit 1; fi

CONC=$(gh run view "$RUN_ID" --json conclusion --jq '.conclusion' 2>/dev/null)
echo "run $RUN_ID 结束：$CONC"

echo ""
echo "拉回结果…"
git pull --rebase origin "$BRANCH" >/dev/null 2>&1 || git pull origin "$BRANCH" >/dev/null 2>&1

if [ -f media-raw/_LAST_RUN.md ]; then
  cat media-raw/_LAST_RUN.md
else
  echo "runner 没产出 _LAST_RUN.md。看日志："
  echo "  gh run view $RUN_ID --log"
fi
